{
  "version": "0.2.0",
  "configurations": [
    {
      // Launch dotnet one file program ```dotnet run app.cs --configuration Release```
      "name": ".NET: Launch Active File",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "run",
        "${file}",
        "--configuration",
        "Release"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      // Launch dotnet one file program ```dotnet run --project AspDemo.csproj --launch-profile dev```
      "name": "asp.net dev (active project)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "${fileDirname}",
        "--launch-profile",
        "dev"
      ],
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      // React app (basket-items-fill): starts `bun run dev`,
      // then opens a browser attached to the debugger.
      "name": "Debug React app (basket-items-fill)",
      "type": "firefox",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/modules/basket-items-fill/react",
    }
  ]
}
