{
  // my custom user settings
  "chat.agent.enabled": false,
  "chat.disableAIFeatures": true,

  "workbench.tree.indent": 18,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 15,
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.editor.tabSizing": "fixed",
  "workbench.editor.tabSizingFixedMaxWidth": 200,
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "workbench.editor.showTabIndex": true,
  "workbench.colorCustomizations": {
    "editor.background": "#222231FF",
    "editorError.foreground": "#d15353",
    "editorError.background": "#ff000022",
  },
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.iconTheme": "vscode-icons",

  "window.zoomLevel": -0.65,
  "window.density.layout": "compact",

  "terminal.integrated.fontSize": 13,
  "indentRainbow.colors": [
    "rgba(255,255,64,0.005)",
    "rgba(127,255,127,0.005)",
    "rgba(255,127,255,0.005)",
    "rgba(79,236,236,0.005)"
  ],

  // tailwind
  "tailwindCSS.experimental.classRegex": [
    ["tv\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],
  "tailwindCSS.classFunctions": [
    "tv",
    "cn",
    "cx",
    "clsx",
    "cvo"
  ],

  // ─── editor basics ───
  "editor.renderWhitespace": "trailing",
  "editor.mouseWheelZoom": true,
  "editor.smoothScrolling": true,
  "editor.minimap.showSlider": "always",
  "editor.minimap.maxColumn": 80,
  "editor.formatOnSave": false,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.lineHeight": 1.5,
  "editor.fontSize": 13,
  "editor.fontFamily": "RobotoMono Nerd Font Mono",
  "terminal.integrated.fontFamily": "'RobotoMono Nerd Font Mono', monospace",
  "editor.tokenColorCustomizations": {
    "[Catppuccin Mocha]": {
      "textMateRules": [
        {
          "scope": [
            "emphasis",
            "comment",
            "comment.block",
            "comment.line",
            "keyword",
            "keyword.control",
            "keyword.operator",
            "storage",
            "storage.type",
            "storage.modifier",
            "entity.name.type",
            "entity.name.tag",
            "entity.name.method",
            "entity.name.function",
            "entity.other.attribute-name",
            "variable",
            "variable.parameter",
            "variable.parameter",
            "variable.language",
            "support.type",
            "support.class",
            "markup.italic"
          ],
          "settings": {
            "fontStyle": ""
          }
        },
        {
          "scope": [
            "variable.name",
          ],
          "settings": {
            //"foreground": "#9cd1d5"
          }
        }
      ]
    }
  },
  // ─── dotnet inlayHints ───
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.inlayHints.fontSize": 10,
  "editor.inlayHints.fontFamily": "Segoe UI Variable",
  "editor.inlayHints.padding": false,
  "dotnet.inlayHints.enableInlayHintsForParameters": true,
  "dotnet.inlayHints.enableInlayHintsForLiteralParameters": true,
  "dotnet.inlayHints.enableInlayHintsForObjectCreationParameters": true,
  "dotnet.inlayHints.enableInlayHintsForIndexerParameters": true,
  "dotnet.inlayHints.enableInlayHintsForOtherParameters": true,

  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  }
}
