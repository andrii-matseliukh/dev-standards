{
  "autoScrollEnabled" : false,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "allowRead": [
        "."
      ],
      "denyWrite": [
        "~/",
        "~/.claude/settings.json",
        "/.claude/settings.local.json",
        "~/.claude/hooks",
        "~/.claude.json",
        "~/.claude/credentials.json",
        "~/setup.sh"
      ],
      "denyRead": [
        "~/.claude.json",
        "~/.claude/credentials.json",
        "**/*.key",
        "**/*.pem",
        "**/*.tfstate*",
        "**/*.tfvars",
        "**/.aws/**",
        "**/.env*",
        "**/.ssh/**",
        "**/appsettings.*.json",
        "**/secrets*.json",
        "**/UserSecrets/**"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash(git worktree:*)"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(npx:*)",
      "Bash(pnpm dlx:*)",
      "Bash(yarn dlx:*)",

      "Bash(npm install:*)",
      "Bash(pnpm install:*)",
      "Bash(yarn install:*)",
      "Bash(bun install:*)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",

      "Bash(dotnet add:*)",
      "Bash(dotnet tool install:*)",
      "Bash(dotnet user-secrets:*)",

      "Bash(sudo *)",

      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.tfstate*)",
      "Read(**/*.tfvars)",
      "Read(**/.aws/**)",
      "Read(**/.env*)",
      "Read(**/.ssh/**)",
      "Read(**/secrets*.json)",
      "Read(**/UserSecrets/**)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "$comment": "play sound, when Claude waiting for user approvals",
            "type": "command",
            "command": "powershell -Command \"(New-Object System.Media.SoundPlayer (Join-Path $env:CLAUDE_PROJECT_DIR '.claude/hooks/notification-sound.wav')).PlaySync()\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "$comment": "show warning when the [X]% (85) threshold of usage in [Y] Model (Opus) is reached",
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/context-threshold.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "$comment": "log every claude exeution command",
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/log-commands.ps1\""
          }
        ]
      }
    ]
  }
}
